{
  "version": 3,
  "configurePresets": [
    {
      "name": "desktop-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x86-64",
      "inherits": ["desktop-base"],
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSYS2 CLANG64 or a MinGW-w64 toolchain)",
      "inherits": ["desktop-base"],
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {
      "name": "windows-x64-cross",
      "displayName": "Windows x64, cross-compiled with MinGW-w64 from Linux",
      "inherits": ["desktop-base"],
      "toolchainFile": "${sourceDir}/desktop/windows/mingw-w64-x86_64.cmake",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal (arm64 + x86_64)",
      "inherits": ["desktop-base"],
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      },
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"}
    }
  ]
}
