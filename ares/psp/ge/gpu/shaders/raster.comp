//Drawing a batch: each workgroup a tile of 16x16 pixels, the jobs that reach the tile (bin.comp) taken in the list's
//order. Each pixel is worked out from its job as ares/psp/ge/raster.cpp works it out (spriteRows(), triangleRows(),
//a point's shadeAs()), the same operations on the same numbers, then textured (texture.glsl) and drawn (pixel.glsl).
//
//The jobs of a word of the tile's bin (up to 32) are first staged in the workgroup's shared memory, the words every
//pixel looks at to find whether the job reaches it (its kind, look and box, a triangle's edges), each loaded once by
//one thread for all 256. Then each thread finds which of them reach its pixel (covering), and the pixels are drawn
//in rounds: in each, every pixel with a job left to draw gives its next one, in order, and those (a pixel and its
//job) are shared out among the threads, the first to the first. So a pixel's jobs are drawn one after another, as
//the software renderer draws them, while the threads that draw stay together: a small triangle's few pixels aren't
//drawn by threads most of which have nothing to do, as they would be by the pixels' own threads. The pixels' values
//are kept in shared memory meanwhile (tileColor, tileDepth, tileWritten), read and written by whoever draws them.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const uint StagedWords = 20u;  //a staged job's: its index, then its words below
const uint StagedKind = 1u, StagedLook = 2u, StagedFirstX = 3u, StagedLastX = 4u, StagedFirstY = 5u;
const uint StagedLastY = 6u, StagedX = 7u, StagedY = 10u, StagedA = 13u, StagedB = 16u, StagedLeast = 19u;
shared uint staged[32u * StagedWords];
//Which record word each staged word is (the index aside)
uint stagedSource(uint word) {
  if(word <= StagedLastY) return word - 1u;  //JobKind to JobLastY
  if(word < StagedLeast) return TriangleX + (word - StagedX);  //the corners, then the edges' a and b
  return TriangleLeast;
}
uint stagedWord(uint slot, uint word) { return staged[slot * StagedWords + word]; }
int stagedInt(uint slot, uint word) { return int(staged[slot * StagedWords + word]); }

shared uint tileColor[256], tileDepth[256], tileWritten[256];  //the pixels' values (written: 1 color, 2 depth)
shared uint items[256];  //a round's: a pixel (its index in the tile) and, << 8, the staged job it draws
shared uint itemCount;

//The frame buffer's byte (8888's or 16-bit's) for pixel (x, y), and the depth buffer's, as the GE reaches it: VRAM's
//fourth copy, which rearranges it (ares/psp/memory/memory.hpp: vramOffset(3, ...)).
uint colorOffset(int x, int y) {
  uint bytes = parameters.format == 3u ? 4u : 2u;
  return (parameters.frameBuffer + (uint(y) * parameters.stride + uint(x)) * bytes) & (VRAMSize - 1u);
}
uint depthOffset(int x, int y) {
  uint seen = (parameters.depthBuffer + (uint(y) * parameters.depthStride + uint(x)) * 2u) & (VRAMSize - 1u);
  seen = (seen & ~0x3e0u) | (seen >> 9 & 1u) << 5 | (seen >> 5 & 15u) << 6;
  return seen ^ 0x2040u;
}

//The pixel's color, through the texture if there is one, plus the shine kept apart (raster.cpp's shadeAs())
void shade(uint look, bool linear, int x, int y, uint z, uint color, uint specular, float u, float v, uint fog) {
  if((lookWord(look, LookFlags) & FlagTextured) != 0u) color = combine(look, color, sampleAt(look, linear, u, v));
  drawPixel(look, x, y, z, addShine(color, specular), fog);
}

//A sprite's pixel: its color and depth are its own; its texture's axes across x and down y were worked out once a
//column and once a row on the CPU (gpu.cpp, as spriteRows() works them out), or a 3D one's down y once a pixel (as
//it works that out); its fog is split at its middle column.
void drawSprite(uint job, uint look, bool linear, int x, int y) {
  uint color = jobWord(job, SpriteColor);
  if((lookWord(look, LookFlags) & FlagTextured) != 0u) {
    uint column = uint(x - jobInt(job, JobFirstX)), row = uint(y - jobInt(job, JobFirstY));
    uint width = uint(jobInt(job, JobLastX) - jobInt(job, JobFirstX) + 1);
    if(jobWord(job, SpriteDivided) != 0u) row = row * width + column;
    ivec3 across = unpackAxis(records[jobWord(job, SpriteColumns) + column]);
    ivec3 down = unpackAxis(records[jobWord(job, SpriteRows) + row]);
    bool turned = jobWord(job, SpriteTurned) != 0u;
    uint texel = turned ? sampleAxes(look, linear, down, across) : sampleAxes(look, linear, across, down);
    color = combine(look, color, texel);
  }
  uint fog = x * 16 + 8 + 1 >= jobInt(job, SpriteMiddle) ? jobWord(job, SpriteRightFog) : jobWord(job, SpriteLeftFog);
  drawPixel(look, x, y, jobWord(job, SpriteZ), addShine(color, jobWord(job, SpriteSpecular)), fog);
}

//A triangle's three colors (four channels each) blended by the weights (raster.cpp's blendColor())
uint blendColor(uint job, uint first, float w0, float w1, float w2, float total) {
  uint c0 = jobWord(job, first), c1 = jobWord(job, first + 1u), c2 = jobWord(job, first + 2u);
  uint color = 0u;
  for(int n = 0; n < 4; n++) {
    float mixed = blend3(float(channel(c0, n)), float(channel(c1, n)), float(channel(c2, n)), w0, w1, w2, total);
    color |= uint(clamp(truncated(mixed), 0, 255)) << uint(n * 8);
  }
  return color;
}
float blendValue(uint job, uint first, float w0, float w1, float w2, float total) {
  return blend3(jobFloat(job, first), jobFloat(job, first + 1u), jobFloat(job, first + 2u), w0, w1, w2, total);
}

//A 2D triangle's texture coordinate. The software renderer steps it in doubles from the leftmost corner (draw.cpp's
//shortStep(): steps cut to 65536ths), start + (x - startX) / 16 * across + (y - startY) / 16 * down, then rounds
//it to a float. gpu.cpp takes only triangles for which that sum is exact in a double (no step of it rounds), and
//sends it here as whole numbers over a power of two: base + (x - startX) * across + (y - startY) * down, in 64 bits,
//over 2^shift. Rounded to a float, that's the very float the software renderer gets.
float wholeCoordinate(uint job, uint base, int shift, int dx, int dy) {
  uvec2 sum = uvec2(jobWord(job, base), jobWord(job, base + 1u));
  sum = wideAdd(sum, wideProduct(dx, jobInt(job, base + 2u)));
  sum = wideAdd(sum, wideProduct(dy, jobInt(job, base + 3u)));
  return ldexp(wideFloat(sum), -shift);
}

//A triangle's pixel: inside where every edge's function is at least its least (exact whole numbers, in 64 bits),
//then blended from the corners by those functions (raster.cpp's triangleRows()). (Its edges are staged: slot.)
void drawTriangle(uint slot, uint job, uint look, bool linear, int x, int y) {
  int sampleX = x * 16 + 8, sampleY = y * 16 + 8;
  uint least = stagedWord(slot, StagedLeast);
  uvec2 edge[3];
  for(uint k = 0u; k < 3u; k++) {
    uint from = (k + 1u) % 3u;
    int dx = sampleX - stagedInt(slot, StagedX + from), dy = sampleY - stagedInt(slot, StagedY + from);
    edge[k] = wideAdd(wideProduct(stagedInt(slot, StagedA + k), dx), wideProduct(stagedInt(slot, StagedB + k), dy));
    if(wideNegative(edge[k]) || ((least >> k & 1u) != 0u && wideZero(edge[k]))) return;
  }
  precise float w0 = wideFloat(edge[0]);
  precise float w1 = wideFloat(edge[1]);
  precise float w2 = wideFloat(edge[2]);
  precise float total = jobFloat(job, TriangleTotal);
  uint flags = lookWord(look, LookFlags), kind = jobWord(job, TriangleFlags);
  bool flatShaded = (kind & 1u) != 0u, shines = (kind & 2u) != 0u, perspective = (kind & 4u) != 0u;
  uint color = flatShaded ? jobWord(job, TriangleFlatColor) : blendColor(job, TriangleColor, w0, w1, w2, total);
  uint specular = !flatShaded && shines ? blendColor(job, TriangleSpecular, w0, w1, w2, total)
                                  : jobWord(job, TriangleFlatSpecular);
  bool needsZ = (flags & FlagDepthRange) != 0u ||
                (flags & ((flags & FlagClear) != 0u ? FlagClearDepth : FlagDepthTest)) != 0u;
  uint z = needsZ ? depthOf(blendValue(job, TriangleZ, w0, w1, w2, total)) : 0u;
  precise float u = 0.0, v = 0.0;
  if((flags & FlagTextured) != 0u && perspective) {
    precise float ka = divide(w0, jobFloat(job, TriangleW));
    precise float kb = divide(w1, jobFloat(job, TriangleW + 1u));
    precise float kc = divide(w2, jobFloat(job, TriangleW + 2u));
    precise float divisor = sum3(ka, kb, kc, jobFloat(job, TriangleQ), jobFloat(job, TriangleQ + 1u),
                                 jobFloat(job, TriangleQ + 2u));
    u = divide(sum3(ka, kb, kc, jobFloat(job, TriangleU), jobFloat(job, TriangleU + 1u),
                    jobFloat(job, TriangleU + 2u)), divisor);
    v = divide(sum3(ka, kb, kc, jobFloat(job, TriangleV), jobFloat(job, TriangleV + 1u),
                    jobFloat(job, TriangleV + 2u)), divisor);
  } else if((flags & FlagTextured) != 0u) {
    int dx = sampleX - jobInt(job, TriangleStartX), dy = sampleY - jobInt(job, TriangleStartY);
    uint shifts = jobWord(job, TriangleShifts);
    u = wholeCoordinate(job, TriangleUBase, int(shifts & 0xffu), dx, dy);
    v = wholeCoordinate(job, TriangleVBase, int(shifts >> 8 & 0xffu), dx, dy);
  }
  uint fog = (flags & FlagFog) != 0u ? fogAmount(blendValue(job, TriangleFog, w0, w1, w2, total)) : 255u;
  shade(look, linear, x, y, z, color, specular, u, v, fog);
}

void drawPoint(uint job, uint look, bool linear, int x, int y) {
  if(x != jobInt(job, PointX) || y != jobInt(job, PointY)) return;
  shade(look, linear, x, y, jobWord(job, PointZ), jobWord(job, PointColor), jobWord(job, PointSpecular),
        jobFloat(job, PointU), jobFloat(job, PointV), jobWord(job, PointFog));
}

//Whether the staged job in slot draws the pixel (x, y): it's in its box, and inside a triangle's edges (as
//drawTriangle() finds them), or a point's own
bool reaches(uint slot, int x, int y) {
  if(x < stagedInt(slot, StagedFirstX) || x > stagedInt(slot, StagedLastX)) return false;
  if(y < stagedInt(slot, StagedFirstY) || y > stagedInt(slot, StagedLastY)) return false;
  uint kind = stagedWord(slot, StagedKind) & 0xffu;
  if(kind == 2u) return x == stagedInt(slot, StagedX) && y == stagedInt(slot, StagedX + 1u);
  if(kind != 1u) return true;
  int sampleX = x * 16 + 8, sampleY = y * 16 + 8;
  uint least = stagedWord(slot, StagedLeast);
  for(uint k = 0u; k < 3u; k++) {
    uint from = (k + 1u) % 3u;
    int dx = sampleX - stagedInt(slot, StagedX + from), dy = sampleY - stagedInt(slot, StagedY + from);
    uvec2 edge = wideAdd(wideProduct(stagedInt(slot, StagedA + k), dx),
                         wideProduct(stagedInt(slot, StagedB + k), dy));
    if(wideNegative(edge) || ((least >> k & 1u) != 0u && wideZero(edge))) return false;
  }
  return true;
}

//The staged job in slot, at the pixel (x, y), which it reaches
void drawJob(uint slot, int x, int y) {
  uint job = stagedWord(slot, 0u), kind = stagedWord(slot, StagedKind), look = stagedWord(slot, StagedLook);
  bool linear = (kind >> 8 & 1u) != 0u;
  if((kind & 0xffu) == 0u) drawSprite(job, look, linear, x, y);
  else if((kind & 0xffu) == 1u) drawTriangle(slot, job, look, linear, x, y);
  else drawPoint(job, look, linear, x, y);
}

//A 16-bit word of which only one half is this thread's: the other may be another's (where a row's last pixel and
//the next row's first share it), so only this half changes.
void storeHalf(uint word, uint value, int lane) {
  uint mask = 0xffffu << uint(lane * 16);
  atomicAnd(vram[word], ~mask);
  atomicOr(vram[word], value & mask);
}

void main() {
  uint tile = gl_WorkGroupID.y * parameters.tilesAcross + gl_WorkGroupID.x;
  uint index = gl_LocalInvocationIndex;  //(y * 16 + x in the tile)
  int x = parameters.tileLeft + int(gl_WorkGroupID.x) * TileSize + int(gl_LocalInvocationID.x);
  int y = parameters.tileTop + int(gl_WorkGroupID.y) * TileSize + int(gl_LocalInvocationID.y);
  bool inside = y >= parameters.areaTop && y <= parameters.areaBottom && x >= parameters.areaLeft &&
                x <= parameters.areaRight;
  frameBufferFormat = parameters.format;
  bool wide = frameBufferFormat == 3u;
  uint colorAt = colorOffset(x, y), depthAt = depthOffset(x, y);  //(bytes)
  if(inside) {
    uint word = vram[colorAt >> 2];
    tileColor[index] = wide ? word : word >> (colorAt & 2u) * 8u & 0xffffu;
    tileDepth[index] = vram[depthAt >> 2] >> (depthAt & 2u) * 8u & 0xffffu;
  }
  tileWritten[index] = 0u;

  //(every thread takes part in staging and in every round, so each loop and barrier is the whole workgroup's: a bin
  //word, and a round's count, are the same for all of them)
  for(uint word = 0u; word < parameters.wordsPerTile; word++) {
    uint jobs = bins[tile * parameters.wordsPerTile + word];
    if(jobs == 0u) continue;
    barrier();  //(the staged jobs before drawn by every thread)
    uint bit = index & 31u;
    if((jobs >> bit & 1u) != 0u) {
      uint job = word * 32u + bit, slot = uint(bitCount(jobs & ((1u << bit) - 1u)));
      for(uint part = index >> 5; part < StagedWords; part += 8u) {
        staged[slot * StagedWords + part] = part == 0u ? job : jobWord(job, stagedSource(part));
      }
    }
    memoryBarrierShared();
    barrier();
    uint covering = 0u, count = uint(bitCount(jobs));
    if(inside) {
      for(uint slot = 0u; slot < count; slot++) covering |= reaches(slot, x, y) ? 1u << slot : 0u;
    }
    while(true) {
      if(index == 0u) itemCount = 0u;
      memoryBarrierShared();
      barrier();
      if(covering != 0u) {
        uint slot = uint(findLSB(covering));
        covering &= covering - 1u;
        items[atomicAdd(itemCount, 1u)] = index | slot << 8;
      }
      memoryBarrierShared();
      barrier();
      uint drawn = itemCount;
      if(drawn == 0u) break;
      if(index < drawn) {
        uint item = items[index], pixel = item & 0xffu;
        pixelColor = tileColor[pixel], pixelDepth = tileDepth[pixel];
        colorWritten = false, depthWritten = false;
        drawJob(item >> 8, x - int(index & 15u) + int(pixel & 15u), y - int(index >> 4) + int(pixel >> 4));
        tileColor[pixel] = pixelColor, tileDepth[pixel] = pixelDepth;
        tileWritten[pixel] |= (colorWritten ? 1u : 0u) | (depthWritten ? 2u : 0u);
      }
      memoryBarrierShared();
      barrier();
    }
  }

  //The pixel's values back in VRAM, where drawing changed them. 8888: its own word. 16-bit: two pixels share a word
  //(the first in an even column, so both in the tile), which the first writes, its neighbour's half too, where both
  //are in the batch's area; one whose neighbour isn't changes only its own half.
  if(inside) tileWritten[index] |= 4u;
  memoryBarrierShared();
  barrier();
  if(!inside) return;
  uint mine = tileWritten[index], theirs = tileWritten[index ^ 1u];
  uint color = tileColor[index], depth = tileDepth[index];
  bool together = (theirs & 4u) != 0u, first = (x & 1) == 0;
  if(wide) {
    if((mine & 1u) != 0u) vram[colorAt >> 2] = color;
  } else if(together) {
    if(first && ((mine | theirs) & 1u) != 0u) vram[colorAt >> 2] = color | tileColor[index ^ 1u] << 16;
  } else if((mine & 1u) != 0u) {
    storeHalf(colorAt >> 2, color << (colorAt & 2u) * 8u, int(colorAt >> 1 & 1u));
  }
  if(together) {
    if(first && ((mine | theirs) & 2u) != 0u) vram[depthAt >> 2] = depth | tileDepth[index ^ 1u] << 16;
  } else if((mine & 2u) != 0u) {
    storeHalf(depthAt >> 2, depth << (depthAt & 2u) * 8u, int(depthAt >> 1 & 1u));
  }
}
