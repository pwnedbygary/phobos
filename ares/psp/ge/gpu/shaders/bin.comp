//Binning: which of the batch's jobs reach each tile of 16x16 pixels, a bit a job (the box it may cover against the
//tile's), 32 jobs to a word. raster.comp then takes, for its tile, only the jobs whose bits are set, in order.
//A workgroup's threads each make one word of one tile: the y of the workgroup is the tile, x the words.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
  uint word = gl_GlobalInvocationID.x, tile = gl_WorkGroupID.y;
  if(word >= parameters.wordsPerTile) return;
  int left = parameters.tileLeft + int(tile % parameters.tilesAcross) * TileSize;
  int top = parameters.tileTop + int(tile / parameters.tilesAcross) * TileSize;
  uint reaching = 0u;
  for(uint bit = 0u; bit < 32u; bit++) {
    uint job = word * 32u + bit;
    if(job >= parameters.jobCount) break;
    if(jobInt(job, JobLastX) >= left && jobInt(job, JobFirstX) < left + TileSize &&
       jobInt(job, JobLastY) >= top && jobInt(job, JobFirstY) < top + TileSize) {
      reaching |= 1u << bit;
    }
  }
  bins[tile * parameters.wordsPerTile + word] = reaching;
}
